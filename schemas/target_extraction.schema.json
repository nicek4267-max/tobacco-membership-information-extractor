{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Target Extraction Schema",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "table_id",
    "records"
  ],

  "properties": {
    "table_id": {
      "type": ["string", "integer"]
    },

    "records": {
      "type": "array",

      "items": {
        "type": "object",
        "additionalProperties": false,

        "required": [
          "indicator_raw",
          "indicator_std",
          "function_type_raw",
          "function_type_std",
          "x1",
          "x2",
          "x3",
          "x4",
          "unit",
          "evidence_row"
        ],

        "properties": {
          "indicator_raw": {
            "type": ["string", "null"]
          },

          "indicator_std": {
            "enum": [
              "pH",
              "OM",
              "TN",
              "AP",
              "AK",
              null
            ]
          },

          "function_type_raw": {
            "type": ["string", "null"]
          },

          "function_type_std": {
            "enum": [
              "parabolic",
              "S-type",
              null
            ]
          },

          "x1": {
            "type": ["number", "null"]
          },

          "x2": {
            "type": ["number", "null"]
          },

          "x3": {
            "type": ["number", "null"]
          },

          "x4": {
            "type": ["number", "null"]
          },

          "unit": {
            "type": ["string", "null"]
          },

          "evidence_row": {
            "type": "object",
            "additionalProperties": false,

            "required": [
              "indicator",
              "function_type",
              "x1",
              "x2",
              "x3",
              "x4",
              "unit"
            ],

            "properties": {
              "indicator": {
                "type": ["string", "null"]
              },

              "function_type": {
                "type": ["string", "null"]
              },

              "x1": {
                "type": ["number", "null"]
              },

              "x2": {
                "type": ["number", "null"]
              },

              "x3": {
                "type": ["number", "null"]
              },

              "x4": {
                "type": ["number", "null"]
              },

              "unit": {
                "type": ["string", "null"]
              }
            }
          }
        }
      }
    }
  }
}